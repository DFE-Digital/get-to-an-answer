@page "/admin/questionnaires/{questionnaireId:guid}/contents/add"
@addTagHelper *, Common
@using Admin.Pages.Contents
@model Admin.Pages.Contents.AddContent

@{
  Layout = "_Layout";
  ViewData["Title"] = "Add or edit a results page";
}

@section BeforeContent
{
  <a class="govuk-back-link govuk-!-display-none-print" href="@Model?.BackLinkSlug">Back</a>
}

@if (Model!.HasErrors())
{
  @await Html.PartialAsync("_ErrorSummary")
}

@await Html.PartialAsync("_ContentForm", new ContentFormModel(
  Model.QuestionnaireTitle,
  Model.BackLinkSlug,
  Model.ContentTitle,
  Model.ContentValue,
  Model.ShowResultsSummary,
  Model.ContentRefName,
  "Include the ability for users to add their answers on the results page before continuing.",
  "SaveAndContinue",
  false))