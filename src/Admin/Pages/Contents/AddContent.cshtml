@page "/admin/questionnaires/{questionnaireId:guid}/contents/add"
@addTagHelper *, Common
@model Admin.Pages.Contents.AddContent

@{
  Layout = "_Layout";
  ViewData["Title"] = "Add or edit a results page";
}

@section BeforeContent
{
  <a class="govuk-back-link govuk-!-display-none-print" href="@Model?.BackLinkSlug">Back</a>
}

@if (Model!.HasErrors())
{
  @await Html.PartialAsync("_ErrorSummary")
}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 id="questionnaire-results-page-heading" class="govuk-heading-l govuk-!-margin-0">
      <p id="current-questionnaire-title" class="govuk-caption-l">@Model.QuestionnaireTitle</p>
      @ViewData["Title"]
    </h1>
    <div class="govuk-hint govuk-!-margin-bottom-8">
      
    </div>
    <form method="post" accept-charset="UTF-8">
      <input type="hidden" asp-for="@Model.BackLinkSlug" />
      @await Html.PartialAsync("Shared/_ContentFormFields", new Admin.Models.ContentFormViewModel
      {
        ContentTitle = Model.ContentTitle,
        ContentValue = Model.ContentValue,
        NoResultContentValue = Model.NoResultContentValue,
        ContentRefName = Model.ContentRefName
      })

      <button id="save-and-continue" class="govuk-button" type="submit" formnovalidate="formnovalidate" data-module="govuk-button"
              data-prevent-double-click="true" asp-page-handler="SaveAndContinue">
        Save and continue
      </button>
    </form>
  </div>
</div>