@model (int? QuestionOrder, bool? HasStartPage)

@if (Model.QuestionOrder == 1 && Model.HasStartPage == true)
{
    <button type="submit" formnovalidate="formnovalidate" class="govuk-back-link" name="submitButton" value="backButtonForStartPage"
            data-module="govuk-button" data-prevent-double-click="true" data-govuk-button-init="">
        Back
    </button>
}
else if (Model.QuestionOrder > 1)
{
    <button type="submit" formnovalidate="formnovalidate" class="govuk-back-link" name="submitButton" value="backButton"
            data-module="govuk-button" data-prevent-double-click="true" data-govuk-button-init="">
        Back
    </button>
}
